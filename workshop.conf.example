# Copy to workshop.conf and edit. workshop.conf is gitignored.
#
#   cp workshop.conf.example workshop.conf
#
# `./scripts/workshop discover` prints what your AWS account offers -- VPCs,
# public subnets, Route53 zones, configured profiles -- which is what you need
# to fill this in.
#
# Nothing here is live. The file is read when you run a command, so an edit
# affects the NEXT command and never a workshop already running.

# =============================================================================
# REQUIRED -- `workshop init` refuses to run without these four.
# =============================================================================

# Hostname students visit.
LAB_DOMAIN=labs.example.com

# VPC for the workshop security group. Instances launch into a public subnet in
# this VPC.
LAB_VPC_ID=

# SSH public key installed on the workshop instance.
LAB_SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub

# The SSM Parameter Store parameter holding the Anthropic API key.
#
# This is the only supported source. The instance fetches the key under its own
# IAM role, so it never sits on this machine and never crosses your ssh session.
# The stack grants the instance read access to exactly this name, so it has to
# be set before `workshop init`. The key itself can be stored any time before
# your first `up`:
#
#   aws ssm put-parameter --name /claude-classroom/anthropic-api-key \
#       --type SecureString --value 'sk-ant-...'
#
# Use a dedicated key with a spend limit set in the Anthropic Console, not your
# main key -- see README.
LAB_SSM_PARAM=/claude-classroom/anthropic-api-key

# =============================================================================
# OPTIONAL -- the defaults shown are what you get if you leave these alone.
# =============================================================================

# AWS profile. Every AWS call this tool makes uses this one profile, so on a
# machine with several, set it deliberately -- `default` is rarely the account
# you mean. `discover` lists the profiles you have.
LAB_AWS_PROFILE=default
LAB_AWS_REGION=us-east-1

# The Route53 hosted zone that LAB_DOMAIN sits under, in THIS account -- e.g.
# the zone for example.com when LAB_DOMAIN is labs.example.com. This is the
# normal case: you already own the domain here, and the stack just adds an A
# record to it.
#
# Leave empty only if you want a SEPARATE zone for the subdomain. The stack then
# creates one and prints nameservers; you must delegate to it with an NS record
# in the parent zone -- which is what you need when the parent lives in a
# different AWS account.
LAB_HOSTED_ZONE_ID=

# Leave empty to auto-select a public subnet in LAB_VPC_ID.
LAB_SUBNET_ID=

# CloudFormation stack and resource tag. Change both to run more than one
# independent lab in the same account.
LAB_STACK=claude-classroom-durable
LAB_TAG=claude-classroom

# Where curricula are read from. Point this at a private directory, or a local
# clone of a private repo, to keep course content out of this repository.
# Contents are copied to the instance at `up` time, so there is no rebuild when
# you edit a lesson.
LAB_CURRICULA_DIR=./curricula

# =============================================================================
# SIZING -- you should not need to touch any of these.
#
# `workshop size --students N` explains every number here and shows the instance
# they produce. They are inputs to choosing that instance, which happens once at
# `up`, so they cannot be used to rescue a class in progress -- that would mean
# `down` and `up` again, destroying student work. What protects a running class
# is already on the box: every container capped and unable to swap, a hard limit
# on concurrent students, and a 4 GiB host swapfile.
#
# If `workshop status` showed the host running tight, tune these for the NEXT
# workshop.
# =============================================================================

# RAM held back for the host itself (Docker, the hub, Caddy).
#LAB_HOST_OVERHEAD_GIB=4

# Measured peak memory of ONE seat, in MiB. This is what the instance size is
# derived from -- not the per-seat cap, which is a ceiling set deliberately
# above real usage.
#
# The default, 1024, was measured on this project's reference exercise: a seat
# running Claude Code through a toolchain install and build peaked at 1036 MiB
# for the whole container. It describes that material, not yours.
#
# Set this once you have measured your own course and the number will be used
# as-is. Leave it unset and the default applies only while --mem is at its own
# default; raise --mem without setting this and sizing falls back to planning
# at the cap, because no measurement exists for a cap that size.
#LAB_PEAK_MIB=1024

# An instance advertised as 64 GiB gives the OS less than that. Sizing compares
# against this fraction of nominal, then requires the headroom below on top, so
# a cohort is never squeezed into a box it only just fits.
#LAB_USABLE_PERCENT=95
#LAB_HEADROOM_PERCENT=10

# Root volume sizing: base + per-student, floored. Sized for tool caches (uv,
# pip, npm), not for authored files. The volume is destroyed at `down`.
#LAB_DISK_BASE_GIB=15
#LAB_DISK_PER_STUDENT_GIB=5
#LAB_DISK_MIN_GIB=20
